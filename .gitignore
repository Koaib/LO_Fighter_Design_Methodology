# =============================================================================
# .gitignore — LO Fighter Design Methodology
# =============================================================================

# ── Windows system files ──────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Tool installations (large binaries — extract locally, do not commit) ──────
Octave*/
POFACETS/

# ── OpenRCS repo (vendored, patched fork — code/docs only, not geometry/data) ─
# Ignore everything under open-rcs by default...
OpenRCS/open-rcs/**
# ...but let git traverse into subfolders...
!OpenRCS/open-rcs/**/
# ...and keep source/doc file types only (no .stl models, no binaries/results):
!OpenRCS/open-rcs/**/*.py
!OpenRCS/open-rcs/**/*.m
!OpenRCS/open-rcs/**/*.md

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/

# ── Generated outputs ─────────────────────────────────────────────────────────
Results/
STL_Files/
VSP_Files/
STP_Files/
Generated_Files/
engines/

# ── Input Geometry ─────────────────────────────────────────────────────────
Geometry*/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── MATLAB / Octave temp files (kept in case old branch is checked out) ───────
*.asv
*.m~

# ── Spyder project files ──────────────────────────────────────────────────────
.spyproject/

# ── Validation script generated outputs ───────────────────────────────────
RCS_Validation/**/stl/
RCS_Validation/**/vsp3/
RCS_Validation/**/results/
RCS_Validation/**/plots/
RCS_Validation/**/coordinates.txt
RCS_Validation/**/facets.txt

# ── dump parameter extraction files ───────────────────────────────────
*.json

# HPC
logs/
script.sh