# =============================================================================
# .gitignore — LO Fighter Design Methodology
# =============================================================================

# ── Windows system files ──────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Tool installations (large binaries — extract locally, do not commit) ──────
OpenVSP*/
Octave*/
POFACETS/

# ── OpenRCS repo (vendored, patched fork committed into OpenRCS/open-rcs/) ────
# No longer ignored — see setup notes for how it was added.

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/

# ── Generated outputs ─────────────────────────────────────────────────────────
Results/
STL_Files/
VSP_Files/
STP_Files/
Aviary_Files/
engines/
scripts/aviary/run_aviary_out/

# ── Input Geometry ─────────────────────────────────────────────────────────
Geometry*/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── MATLAB / Octave temp files (kept in case old branch is checked out) ───────
*.asv
*.m~

# ── Spyder project files ──────────────────────────────────────────────────────
.spyproject/

# ── Validation script generated outputs ───────────────────────────────────
RCS_Validation/**/stl/
RCS_Validation/**/vsp3/
RCS_Validation/**/results/
RCS_Validation/**/plots/
RCS_Validation/**/coordinates.txt
RCS_Validation/**/facets.txt

# ── dump parameter extraction files ───────────────────────────────────
*.json